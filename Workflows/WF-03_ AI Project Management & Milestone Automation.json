      "parameters": {
        "promptType": "define",
        "text": "=Client\n\n{{$json.Client_Name}}\n\nCompany\n\n{{$json.Company}}\n\nProject\n\n{{$json.Project_Title}}\n\nDescription\n\n{{$json.Project_Description}}\n\nBudget\n\n{{$json.Budget}}\n\nDeadline\n\n{{$json.Deadline}}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a Senior Technical Project Manager working in an AI Automation Company.\n\nCreate a complete project execution plan.\n\nReturn ONLY valid JSON.\n\nSchema:\n\n{\n\"project_duration\":\"\",\n\"estimated_completion\":\"\",\n\"risk_level\":\"\",\n\"meeting_agenda\":\"\",\n\"milestones\":[\n{\n\"name\":\"\",\n\"duration\":\"\",\n\"deliverables\":\"\",\n\"tasks\":[\n{\n\"task\":\"\",\n\"description\":\"\",\n\"priority\":\"\",\n\"estimated_hours\":\"\"\n}\n]\n}\n]\n}\n\nRules:\n\nReturn JSON only.\n\nNo markdown.\n\nGenerate exactly 4 milestones.\n\nEach milestone must contain exactly 4 tasks.\n\nPriorities:\n\nHigh\n\nMedium\n\nLow"
            }
          ]
        },
        "batching": {}
      },
