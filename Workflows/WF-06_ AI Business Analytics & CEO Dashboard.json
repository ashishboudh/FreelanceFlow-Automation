    {
      "parameters": {
        "jsCode": "const leads = $('Load Leads').all().length;\nconst proposals = $('Load Proposals').all();\nconst projects = $('Load Projects').all();\nconst invoices = $('Load Invoices').all();\nconst payments = $('Load Payments').all();\nconst testimonials = $('Load Testimonials').all();\n\nconst qualified = $('Load Leads').all()\n.filter(i => i.json.Decision === \"Qualified\").length;\n\nconst completedProjects = projects.filter(i => i.json.Project_Status === \"Completed\").length;\n\nconst activeProjects = projects.filter(i => i.json.Project_Status !== \"Completed\").length;\n\nconst revenue = payments\n.filter(i => i.json.Payment_Status === \"Paid\")\n.reduce((sum,i)=>sum+Number(i.json.Amount||0),0);\n\nconst pending = payments\n.filter(i=>i.json.Payment_Status===\"Pending\")\n.reduce((sum,i)=>sum+Number(i.json.Amount||0),0);\n\nconst ratings = testimonials.map(i=>Number(i.json.Rating||0));\n\nconst avgRating = ratings.length\n? ratings.reduce((a,b)=>a+b,0)/ratings.length\n:0;\n\nreturn [{\njson:{\nTotal_Leads:leads,\nQualified_Leads:qualified,\nProposal_Count:proposals.length,\nActive_Projects:activeProjects,\nCompleted_Projects:completedProjects,\nRevenue:revenue,\nPending_Payments:pending,\nAvg_Rating:avgRating.toFixed(1)\n}\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        16
      ],
      "id": "7fc2ec11-629b-46c0-933a-d4a4250d16a0",
      "name": "Calculate KPIs"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Business Metrics\n\nTotal Leads:\n{{$json.Total_Leads}}\n\nQualified Leads:\n{{$json.Qualified_Leads}}\n\nProposals:\n{{$json.Proposal_Count}}\n\nActive Projects:\n{{$json.Active_Projects}}\n\nCompleted Projects:\n{{$json.Completed_Projects}}\n\nRevenue:\n₹{{$json.Revenue}}\n\nPending Payments:\n₹{{$json.Pending_Payments}}\n\nAverage Rating:\n{{$json.Avg_Rating}}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are the CEO Business Analyst of an AI Automation Company.\n\nAnalyze the weekly business metrics.\n\nReturn ONLY valid JSON.\n\nSchema:\n\n{\n\"summary\":\"\",\n\"growth\":\"\",\n\"recommendations\":[\n\"\",\n\"\",\n\"\"\n],\n\"priority_focus\":\"\",\n\"overall_health\":\"\"\n}\n\nRules:\n\nProfessional.\n\nExecutive level.\n\nNo markdown.\n\nReturn JSON only."
            }
          ]
        },
        "batching": {}
      },
