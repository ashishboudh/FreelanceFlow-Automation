    {
      "parameters": {
        "jsCode": "let text =\n$json.text ||\n$json.output ||\n$json.response ||\n$json.content ||\n\"\";\n\ntext = text\n.replace(/```json/g, \"\")\n.replace(/```/g, \"\")\n.trim();\n\nconst ai = JSON.parse(text);\n\nreturn [{\n  json: {\n    ...$('Calculate KPIs').first().json,\n    ...ai\n  }\n}];"
