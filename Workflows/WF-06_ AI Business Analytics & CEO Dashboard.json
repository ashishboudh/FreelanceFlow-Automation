      "parameters": {
        "sendTo": "ashishboudh1829@gmail.com",
        "subject": "=Weekly Business Report - {{$today}}",
        "message": "=<h2>FreelanceFlow AI Weekly Report</h2>\n\n<b>Total Leads:</b> {{$('Calculate KPIs').item.json.Total_Leads}}<br>\n\n<b>Qualified Leads:</b> {{$('Calculate KPIs').item.json.Qualified_Leads}}<br>\n\n<b>Revenue:</b> ₹{{$('Calculate KPIs').item.json.Revenue}}<br>\n\n<b>Pending Payments:</b> ₹{{$('Calculate KPIs').item.json.Pending_Payments}}<br>\n\n<b>Average Rating:</b> {{$('Calculate KPIs').item.json.Avg_Rating}} ⭐\n\n<hr>\n\n<h3>AI Executive Summary</h3>\n\n{{ $('AI Business Analyst').item.json.text }}\n\n<hr>\n\n<h3>Recommendations</h3>\n\n<ul>\n<li>{{$json.recommendations[0]}}</li>\n<li>{{$json.recommendations[1]}}</li>\n<li>{{$json.recommendations[2]}}</li>\n</ul>\n\n<h3>Priority Focus</h3>\n\n{{$json.priority_focus}}\n\n<h3>Overall Business Health</h3>\n\n{{$json.overall_health}}",
