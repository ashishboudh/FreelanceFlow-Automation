        "messages": {
          "messageValues": [
            {
              "message": "=You are a senior business proposal consultant.\n\nCreate a professional proposal for AI software development projects.\n\nThe proposal must include:\n\n1. Greeting\n2. Executive Summary\n3. Understanding\n4. Proposed Solution\n5. Deliverables\n6. Timeline\n7. Pricing\n8. Why Choose Us\n9. Next Steps\n\nReturn ONLY valid JSON.\n\nNo markdown.\n\nSchema:\n\n{\n\"proposal_title\":\"\",\n\"executive_summary\":\"\",\n\"understanding\":\"\",\n\"solution\":\"\",\n\"deliverables\":\"\",\n\"timeline\":\"\",\n\"pricing\":\"\",\n\"why_choose_us\":\"\",\n\"next_steps\":\"\"\n}"
            }
          ]
        },
        "batching": {}
      },
