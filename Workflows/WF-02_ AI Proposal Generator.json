    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody{\n  font-family: Arial, Helvetica, sans-serif;\n  margin:40px;\n  color:#333;\n  line-height:1.8;\n}\n.header{\n  text-align:center;\n  border-bottom:4px solid #2563eb;\n  padding-bottom:20px;\n  margin-bottom:40px;\n}\n.logo{\n  font-size:34px;\n  font-weight:bold;\n  color:#2563eb;\n}\n.subtitle{\n  font-size:18px;\n  color:#666;\n}\n.section{\n  margin-top:35px;\n}\n.section h2{\n  color:#2563eb;\n  border-bottom:1px solid #ddd;\n  padding-bottom:8px;\n}\n.table{\n  width:100%;\n  border-collapse:collapse;\n  margin-top:20px;\n}\n.table td{\n  border:1px solid #ddd;\n  padding:12px;\n}\n.footer{\n  margin-top:70px;\n  text-align:center;\n  font-size:13px;\n  color:#777;\n  border-top:1px solid #ddd;\n  padding-top:20px;\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"header\">\n  <div class=\"logo\">ORITHM AI</div>\n  <div class=\"subtitle\">Professional AI Automation Proposal</div>\n</div>\n\n<h1>${data.Proposal_Title || \"\"}</h1>\n\n<div class=\"section\">\n<h2>Prepared For</h2>\n\n<table class=\"table\">\n<tr>\n<td><b>Client</b></td>\n<td>${data.Client_Name || \"\"}</td>\n</tr>\n\n<tr>\n<td><b>Company</b></td>\n<td>${data.Company || \"\"}</td>\n</tr>\n\n<tr>\n<td><b>Project</b></td>\n<td>${data.Project_Title || \"\"}</td>\n</tr>\n\n<tr>\n<td><b>Date</b></td>\n<td>${new Date().toLocaleDateString()}</td>\n</tr>\n</table>\n</div>\n\n<div class=\"section\">\n<h2>Executive Summary</h2>\n<p>${data.Executive_Summary || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Project Understanding</h2>\n<p>${data.Understanding || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Proposed Solution</h2>\n<p>${data.Solution || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Deliverables</h2>\n<p>${data.Deliverables || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Timeline</h2>\n<p>${data.Timeline || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Pricing</h2>\n<p>${data.Pricing || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Why Choose Orithm AI</h2>\n<p>${data.Why_Choose_Us || \"\"}</p>\n</div>\n\n<div class=\"section\">\n<h2>Next Steps</h2>\n<p>${data.Next_Steps || \"\"}</p>\n</div>\n\n<div class=\"footer\">\nGenerated automatically by <b>FreelanceFlow AI</b><br>\n© 2026 Orithm AI\n</div>\n\n</body>\n</html>\n`;\n\nreturn [\n  {\n    json: {\n      ...data,\n      html\n    }\n  }\n];"
      },
