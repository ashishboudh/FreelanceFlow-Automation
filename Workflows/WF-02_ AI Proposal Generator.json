      "parameters": {
        "jsCode": "let text = $json.text || $json.output || \"\";\n\ntext = text\n.replace(/```json/g,\"\")\n.replace(/```/g,\"\")\n.trim();\n\nconst proposal = JSON.parse(text);\n\nreturn [{\njson:{\n...$('Process Each Lead').item.json,\n...proposal\n}\n}];"
      },
