      "parameters": {
        "promptType": "define",
        "text": "=Client Name:\n\n{{$json.Client_Name}}\n\nProject:\n\n{{$json.Project_Title}}\n\nRating:\n\n{{ $('Normalize Feedback').item.json.Rating }}\n\nFeedback:\n\n{{ $('Normalize Feedback').item.json.Feedback }}\n\nRecommended:\n\n{{ $('Normalize Feedback').item.json.Recommend }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a Customer Success Manager for an AI Automation company.\n\nAnalyze the client review.\n\nReturn ONLY valid JSON.\n\nSchema:\n\n{\n\"sentiment\":\"Positive\",\n\"customer_satisfaction\":0,\n\"summary\":\"\",\n\"publish_portfolio\":true,\n\"follow_up_required\":false,\n\"thank_you_email\":\"\"\n}\n\nRules:\n\nSentiment must be:\n\nPositive\n\nNeutral\n\nNegative\n\ncustomer_satisfaction = 1-100\n\npublish_portfolio = true only if\n\nRating >=4\n\nFeedback is positive\n\nNo markdown.\n\nReturn JSON only."
            }
          ]
        },
        "batching": {}
      },
